<!DOCTYPE html>
<html>
  <head>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <title>{{title}}</title>
    <style>
        * {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }

        body {
          font-family: Inter, Arial, sans-serif;
          background: #1B3C53;
          padding: 40px;
          color: #E3E3E3;
        }

        h1 {
          margin-bottom: 25px;
          font-size: 32px;
          font-weight: 600;
          color: #E3E3E3;
        }
        ul {
          list-style: none;
        }

        .file-entry {
          background: #456882;
          padding: 16px 20px;
          border-radius: 10px;
          margin-bottom: 16px;

          display: flex;
          flex-direction: column;
          gap: 8px;

          box-shadow: 0 1px 4px rgba(0,0,0,0.05);
          border: 1px solid #234C6A;
        }

        button {
          align-self: start;
          padding: 8px 14px;

          background: #E3E3E3;
          border: none;
          color: black;

          border-radius: 6px;
          font-size: 14px;
          cursor: pointer;
          transition: background 0.2s;
        }

        button:hover {
          background: #1B3C53;
          color: white;
        }

        button:active {
          background: #456882;
          color: white;
        }

        .progress-container {
          width: 100%;
          height: 10px;
          background-color: #e5e7eb;
          border-radius: 5px;
          overflow: hidden;
        }

        .progress-bar {
          height: 100%;
          background-color: #10b981; 
          width: 0%;
          transition: width 0.2s;
        }

        .status {
          font-size: 13px;
          color: #E3E3E3;
        }

    </style>
  </head>

  <body>
    <h1>{{title}}</h1>

    <ul>
      {{#each files}}
        <li class="file-entry">
          {{this}} —
          <!--  Pass @index directly to JS -->
          <button onclick="sendToConsumer('{{this}}', {{@index}})">Send to Consumer</button>
          <div class="progress-container">
            <div class="progress-bar" id="bar-{{@index}}"></div>
          </div>
          <div class="status" id="status-{{@index}}"></div>
        </li>
      {{/each}}
    </ul>

    <script>
      function sendToConsumer(filename, index) {
        const bar = document.getElementById(`bar-${index}`);
        const status = document.getElementById(`status-${index}`);

        // Paranoid
        if (!bar || !status) {
          console.error("Missing progress bar/status element for", filename);
          return;
        }
        // This updates the progress bar, XML for progress tracking
        const xhr = new XMLHttpRequest();
        // .open("METHOD","URL","IS_ASYNC")
        xhr.open("POST", `/send/${filename}`, true);
        // On any change
        xhr.upload.onprogress = (event) => {
          if (event.lengthComputable) {
            // Compute percentage of the length
            const percent = (event.loaded / event.total) * 100;
            bar.style.width = percent + "%";
            status.textContent = `Uploading ${filename}: ${percent.toFixed(1)}%`;
          }
        };
        // Once finished then update the status of the bar
        xhr.onload = () => {
          if (xhr.status === 200) {
            bar.style.width = "100%";
            status.textContent = ` Uploaded successfully!`;
          } else {
            status.textContent = ` Upload failed (${xhr.status})`;
          }
        };

        // Otherwise put an error message
        xhr.onerror = () => {
          status.textContent = " Network error during upload.";
        };
        
        // Start the request
        xhr.send();
      }
    </script>
  </body>
</html>
