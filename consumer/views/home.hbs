<!DOCTYPE html>
<html>
<head>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <title>{{title}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: Inter, Arial, sans-serif;
      background: #1B3C53;
      padding: 40px;
      color: #E3E3E3;
    }
    h1 { margin-bottom: 25px; font-size: 32px; font-weight: 600; }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 20px;
    }

    .video-card {
      background: #456882;
      border-radius: 10px;
      padding: 10px;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      gap: 10px;
      transition: 0.2s;
      border: 1px solid #234C6A;
      box-shadow: 0 1px 4px rgba(0,0,0,0.05);
    }

    .video-card:hover { background: #567B95; }

    .video-card video {
      width: 100%;
      height: 170px;
      border-radius: 8px;
      object-fit: cover;
      background: black;
    }

    #playerModal {
      display: none;
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      background: rgba(0,0,0,0.85);
      justify-content: center;
      align-items: center;
      z-index: 999;
    }

    #videoPlayer {
      width: 80%;
      max-width: 900px;
      border-radius: 12px;
    }
  </style>
</head>
<body>
  <h1>{{title}}</h1>

  <div id="videoContainer" class="video-grid"></div>

  <div id="playerModal" onclick="closeModal()">
    <video id="videoPlayer" controls></video>
  </div>

<script>
const videoContainer = document.getElementById("videoContainer");
const existingVideos = new Set();

// -------- Load & refresh videos -------- //
async function refreshVideos() {
  try {
    const res = await fetch("/api/videos");
    const { videos, previews } = await res.json();

    videos.forEach(file => {
      if (existingVideos.has(file)) return;

      const base = file.replace(".mp4", "");
      const previewName = previews.find(p => p.includes(base));

      const card = document.createElement("div");
      card.className = "video-card";

      card.innerHTML = `
        <video 
          src="/uploads/${file}" 
          muted 
          preload="metadata"
          onmouseover="showPreview(this, '/previews/${previewName}')"
          onmouseout="stopPreview(this, '/uploads/${file}')"
        ></video>
        <p>${file}</p>
      `;

      card.onclick = () => playVideo(`/uploads/${file}`);
      videoContainer.appendChild(card);

      existingVideos.add(file);
    });

  } catch (err) {
    console.error("Failed to load videos", err);
  }
}

// -------- Hover preview that loops 10 seconds -------- //
function showPreview(videoTag, previewSrc) {
  if (!previewSrc) return;
  videoTag.src = previewSrc;
  videoTag.currentTime = 0;
  videoTag.loop = true;
  videoTag.play().catch(() => {});
}

function stopPreview(videoTag, fullSrc) {
  videoTag.pause();
  videoTag.loop = false;
  videoTag.src = fullSrc;
}

// -------- Modal play -------- //
function playVideo(src) {
  const modal = document.getElementById("playerModal");
  const player = document.getElementById("videoPlayer");
  player.src = src;
  player.play();
  modal.style.display = "flex";
}

function closeModal() {
  const modal = document.getElementById("playerModal");
  const player = document.getElementById("videoPlayer");
  player.pause();
  player.src = "";
  modal.style.display = "none";
}

// -------- Initial load -------- //
refreshVideos();
setInterval(refreshVideos, 5000);
</script>
</body>
</html>
